#!/bin/sh
# Gate every push to main (ADR-0007): lint, typecheck and unit tests must pass. CI also runs build + e2e.
# Pick the Node version from .nvmrc when nvm is available, so the hook works from any shell.
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent >/dev/null 2>&1 || true
fi
exec pnpm check
